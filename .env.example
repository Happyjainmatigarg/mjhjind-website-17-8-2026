# --- Admin credentials (optional) ---
# If not set, the admin panel defaults to username "admin" / password "mjadmin2024".
# Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mjadmin2024

# --- Session & secret-encryption keys (recommended in production) ---
# ADMIN_SESSION_SECRET signs admin session tokens.
# ADMIN_SETTINGS_SECRET encrypts stored email/payment secrets (AES-GCM).
# Use long random strings (e.g. `openssl rand -hex 32`).
# If unset, a value is derived from the admin password — secrets then stop
# decrypting if the password changes, so set these explicitly in production.
# ADMIN_SESSION_SECRET=change-me
# ADMIN_SETTINGS_SECRET=change-me

# --- Email delivery ---
# Two options. These can also be configured entirely in the admin panel under
# "Email & Notifications" (admin settings take precedence over env vars).
#
# Option A: provider HTTP API (works on edge/serverless)
#   Providers: resend | sendgrid | brevo
# MAIL_API_KEY=your-provider-api-key
#
# Option B: SMTP (e.g. Gmail)
#   Enable 2-Step Verification, then create an App Password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-hospital@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional: override the "From" address (defaults to the SMTP user)
# MAIL_FROM=Meenakshi Jain Hospital <your-hospital@gmail.com>

# --- Notification recipients ---
# Comma-separated list of admin/management email addresses that receive
# notifications for new appointments, camp registrations, contact messages,
# and newsletter subscribers.
ADMIN_NOTIFY_EMAILS=admin@mjhospital.in,reception@mjhospital.in

# --- Site URL (used in email links) ---
# Set to your public site URL so links in emails resolve correctly.
# SITE_URL=https://mjhospital.in
