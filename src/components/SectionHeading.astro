---
interface Props {
  eyebrow?: string
  title: string
  subtitle?: string
  align?: 'left' | 'center'
  class?: string
}
const { eyebrow, title, subtitle, align = 'center', class: className = '' } = Astro.props
---

<div class:list={['max-w-3xl', align === 'center' ? 'mx-auto text-center' : '', className]}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="text-3xl font-bold tracking-tight text-balance md:text-h2">{title}</h2>
  {subtitle && <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-slate-400">{subtitle}</p>}
</div>
