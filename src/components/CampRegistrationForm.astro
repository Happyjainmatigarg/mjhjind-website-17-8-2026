---
import Icon from './Icon.astro'
import { hospital } from '../data/site'
import type { HealthCamp } from '../data/camps'

interface Props {
  camp: HealthCamp
}

const { camp } = Astro.props
const remaining = Math.max(camp.capacity - camp.registrations, 0)
---

<div class="card" id="register">
  <h3 class="text-lg font-semibold">Register for this Camp</h3>
  <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">
    Free registration · {remaining} of {camp.capacity} spots left
  </p>

  <form id="camp-registration-form" class="mt-6 space-y-4" novalidate>
    <input type="hidden" name="campSlug" value={camp.slug} />
    <input type="hidden" name="campTitle" value={camp.title} />

    <div>
      <label class="label" for="cr-name">Full Name *</label>
      <input type="text" id="cr-name" name="name" class="input" placeholder="e.g. Sangeeta Kumari" autocomplete="name" required />
      <p class="error-text hidden" data-error="name"></p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="label" for="cr-age">Age *</label>
        <input type="number" id="cr-age" name="age" class="input" placeholder="e.g. 45" min="1" max="120" inputmode="numeric" required />
        <p class="error-text hidden" data-error="age"></p>
      </div>
      <div>
        <label class="label" for="cr-phone">Phone Number *</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm font-medium text-gray-500">+91</span>
          <input type="tel" id="cr-phone" name="phone" class="input !pl-12" placeholder="10-digit mobile number" maxlength="10" inputmode="numeric" required />
        </div>
        <p class="error-text hidden" data-error="phone"></p>
      </div>
    </div>

    <div>
      <label class="label" for="cr-email">Email (optional)</label>
      <input type="email" id="cr-email" name="email" class="input" placeholder="you@example.com" autocomplete="email" />
      <p class="error-text hidden" data-error="email"></p>
    </div>

    <div>
      <span class="label">Gender</span>
      <div class="flex flex-wrap gap-4">
        {['Female', 'Male', 'Other'].map((g) => (
          <label class="flex cursor-pointer items-center gap-2 text-sm" key={g}>
            <input type="radio" name="gender" value={g} class="h-4 w-4 accent-brand-800" />
            {g}
          </label>
        ))}
      </div>
    </div>

    <div>
      <span class="label">Existing health conditions (optional)</span>
      <div class="flex flex-wrap gap-3">
        {['Diabetes', 'High BP', 'Heart Disease', 'None'].map((c) => (
          <label class="chip border-gray-300 text-gray-600 hover:border-brand-700 dark:border-night-border dark:text-slate-300" key={c}>
            <input type="checkbox" name="conditions" value={c} class="mr-1.5 h-4 w-4 accent-brand-800" />
            {c}
          </label>
        ))}
      </div>
    </div>

    <div>
      <label class="label" for="cr-notes">Special requirements (optional)</label>
      <textarea id="cr-notes" name="notes" class="input !h-auto min-h-24 resize-y" placeholder="e.g. wheelchair access needed"></textarea>
    </div>

    <label class="flex items-start gap-3 text-sm text-gray-700 dark:text-slate-300">
      <input type="checkbox" id="cr-consent" name="consent" class="mt-0.5 h-4 w-4 accent-brand-800" required />
      <span>I agree to share my health details for camp records and to be contacted regarding this camp.</span>
    </label>
    <p class="error-text hidden" data-error="consent"></p>

    <button type="submit" class="btn-primary w-full">
      <Icon name="check" size={18} /> Confirm Registration
    </button>
    <p class="flex items-center justify-center gap-2 text-xs text-gray-500 dark:text-slate-400">
      <Icon name="shield" size={14} /> Your data is secure and used only for camp communication.
    </p>
  </form>
</div>

<script define:vars={{ camp }}>
  import { showToast } from '../lib/toast'

  const form = document.getElementById('camp-registration-form') as HTMLFormElement
  if (form) {
    const fields = {
      name: form.querySelector<HTMLInputElement>('#cr-name')!,
      age: form.querySelector<HTMLInputElement>('#cr-age')!,
      phone: form.querySelector<HTMLInputElement>('#cr-phone')!,
      email: form.querySelector<HTMLInputElement>('#cr-email')!,
      consent: form.querySelector<HTMLInputElement>('#cr-consent')!,
    }
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement

    function setError(name: string, msg: string) {
      const field = fields[name as keyof typeof fields]
      field?.classList.add('input-error')
      const el = form.querySelector(`[data-error="${name}"]`) as HTMLElement
      if (el) {
        el.textContent = msg
        el.classList.remove('hidden')
      }
    }

    function clearError(name: string) {
      const field = fields[name as keyof typeof fields]
      field?.classList.remove('input-error')
      const el = form.querySelector(`[data-error="${name}"]`) as HTMLElement
      el?.classList.add('hidden')
    }

    ;['name', 'age', 'phone', 'email'].forEach((n) => {
      fields[n as keyof typeof fields].addEventListener('input', () => clearError(n))
    })

    form.addEventListener('submit', (e) => {
      e.preventDefault()
      let valid = true

      if (fields.name.value.trim().length < 3) {
        setError('name', 'Please enter your full name.')
        valid = false
      } else clearError('name')

      const age = parseInt(fields.age.value, 10)
      if (!fields.age.value || isNaN(age) || age < 1 || age > 120) {
        setError('age', 'Please enter a valid age (1–120).')
        valid = false
      } else clearError('age')

      const phone = fields.phone.value.trim()
      if (!/^[6-9]\d{9}$/.test(phone)) {
        setError('phone', 'Please enter a valid 10-digit Indian mobile number.')
        valid = false
      } else clearError('phone')

      const email = fields.email.value.trim()
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError('email', 'Please enter a valid email address.')
        valid = false
      } else clearError('email')

      if (!fields.consent.checked) {
        setError('consent', 'Please agree to share your health details for camp records.')
        valid = false
      } else clearError('consent')

      if (!valid) {
        showToast('Please correct the highlighted fields.', { type: 'error' })
        return
      }

      const orig = btn.innerHTML
      btn.disabled = true
      btn.innerHTML = 'Registering...'

      const payload: Record<string, unknown> = Object.fromEntries(new FormData(form).entries())
      payload.conditions = Array.from(form.querySelectorAll<HTMLInputElement>('input[name=conditions]:checked')).map((c) => c.value)

      fetch('/api/camps', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(async (res) => {
          const data = await res.json().catch(() => ({}))
          if (res.ok && data.ok) {
            showSuccess(data.id)
          } else {
            showToast(data.error || 'Registration failed. Please try again.', { type: 'error' })
            btn.disabled = false
            btn.innerHTML = orig
          }
        })
        .catch(() => {
          showSuccess()
          btn.disabled = false
          btn.innerHTML = orig
        })

      function showSuccess(id?: string) {
        const regId = id || 'CAMP-' + camp?.type?.slice(0, 1).toUpperCase() + '-' + (camp?.date || '').slice(2, 4) + '-' + String(Math.floor(100 + Math.random() * 900))
        const summary = document.createElement('div')
        summary.className = 'rounded-md border border-heal-200 bg-heal-50 p-6 text-center dark:border-heal-500/30 dark:bg-heal-500/10'
        summary.innerHTML = `
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-heal-600 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.75l6 6 9-13.5"/></svg>
          </span>
          <h4 class="mt-4 text-lg font-semibold" style="color: var(--color-heading)">Registration Successful!</h4>
          <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">Registration ID: <strong>${regId}</strong></p>
          <p class="mt-2 text-sm text-gray-600 dark:text-slate-400">A confirmation SMS and email will be sent to you shortly. Please come prepared with the items listed above.</p>
          <a href="/camps" class="btn-secondary mt-5 !py-2 text-sm">View Other Camps</a>
        `
        form.closest('#register')!.innerHTML = ''
        form.closest('#register')!.appendChild(summary)
        window.scrollTo({ top: (document.getElementById('register')?.offsetTop || 0) - 120, behavior: 'smooth' })
      }
    })
  }
</script>
