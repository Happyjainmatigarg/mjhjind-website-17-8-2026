---
import ImagePlaceholder from './ImagePlaceholder.astro'
import Icon from './Icon.astro'
import type { HealthCamp } from '../data/camps'
import { formatShortDate, daysUntil, isUpcoming } from '../lib/utils'

interface Props {
  camp: HealthCamp
  showProgress?: boolean
}

const { camp, showProgress = true } = Astro.props
const upcoming = isUpcoming(camp.date)
const filled = camp.capacity > 0 ? Math.round((camp.registrations / camp.capacity) * 100) : 0
const isFull = camp.registrations >= camp.capacity
const days = daysUntil(camp.date)
---

<article class="card card-hover flex h-full flex-col overflow-hidden p-0" data-camp-slug={camp.slug}>
  <div class="relative">
    <ImagePlaceholder image={camp.image} title={camp.type} />
    <div class="absolute left-4 top-4 flex gap-2">
      <span class:list={['badge', upcoming ? 'badge-green' : 'badge-gray']}>
        {upcoming ? 'Upcoming' : 'Past'}
      </span>
      <span class:list={['badge', isFull ? 'badge-red' : 'badge-orange']}>
        {isFull ? 'Full' : camp.registrations >= camp.capacity * 0.8 ? 'Few seats left' : 'Registration Open'}
      </span>
    </div>
    <div class="absolute bottom-4 right-4 rounded-md bg-black/60 px-3 py-1.5 text-center backdrop-blur-sm">
      <p class="text-lg font-bold leading-none text-white">{camp.date.slice(8)}</p>
      <p class="text-[11px] font-medium text-white/80">{camp.date.slice(5, 7)} {camp.date.slice(0, 4)}</p>
    </div>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold leading-snug">{camp.title}</h3>
    <div class="mt-3 space-y-1.5 text-sm text-gray-600 dark:text-slate-400">
      <p class="flex items-start gap-2">
        <Icon name="clock" size={16} class="mt-0.5 shrink-0 text-brand-700 dark:text-brand-400" /> {camp.time}
      </p>
      <p class="flex items-start gap-2">
        <Icon name="map-pin" size={16} class="mt-0.5 shrink-0 text-brand-700 dark:text-brand-400" /> {camp.location}
      </p>
    </div>
    {upcoming && showProgress && (
      <div class="mt-4">
        <div class="mb-1 flex items-center justify-between text-xs">
          <span class="text-gray-500 dark:text-slate-400">{camp.registrations} / {camp.capacity} registered</span>
          <span class="font-semibold text-brand-700 dark:text-brand-400">{filled}%</span>
        </div>
        <div class="h-2 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-night-border">
          <div class:list={['h-full rounded-full transition-all', isFull ? 'bg-danger-500' : 'bg-heal-500']} style={`width: ${Math.min(filled, 100)}%`}></div>
        </div>
      </div>
    )}
    {upcoming && (
      <p class="mt-3 text-xs font-medium text-warm-600 dark:text-warm-400">
        {days === 0 ? 'Happening today!' : days === 1 ? 'Happening tomorrow' : `In ${days} days`}
      </p>
    )}
    <div class="mt-5 flex gap-2 border-t pt-5 dark:border-night-border">
      <a href={`/camps/${camp.slug}`} class="btn-secondary flex-1 !px-3 !py-2.5 text-sm">View Details</a>
      {upcoming && !isFull && (
        <a href={`/camps/${camp.slug}#register`} class="btn-primary flex-1 !px-3 !py-2.5 text-sm">
          <Icon name="user-group" size={16} /> Register
        </a>
      )}
    </div>
  </div>
</article>
