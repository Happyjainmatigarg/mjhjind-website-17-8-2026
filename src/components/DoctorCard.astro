---
import DoctorAvatar from './DoctorAvatar.astro'
import Icon from './Icon.astro'
import type { Doctor } from '../data/doctors'

interface Props {
  doctor: Doctor
  showBooking?: boolean
}

const { doctor: d, showBooking = true } = Astro.props
---

<article class="card card-hover flex h-full flex-col overflow-hidden p-0">
  <div class="flex flex-col items-center px-6 pt-8 text-center">
    <DoctorAvatar name={d.name} size={120} class="ring-4 ring-brand-100 dark:ring-night-border" />
    <h3 class="mt-4 text-lg font-semibold">{d.name}</h3>
    <p class="text-sm font-medium text-brand-700 dark:text-brand-400">{d.specialty}</p>
    <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">{d.qualification}</p>
    <p class="mt-2 inline-flex items-center gap-1 rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-night-border dark:text-slate-300">
      <Icon name="award" size={13} /> Reg. {d.registrationNumber}
    </p>
    <div class="mt-3 flex flex-wrap items-center justify-center gap-3 text-xs text-gray-600 dark:text-slate-400">
      <span class="inline-flex items-center gap-1">
        <Icon name="briefcase" size={14} /> {d.experience} yrs exp
      </span>
      <span class:list={['inline-flex items-center gap-1', d.availableToday ? 'text-heal-600 dark:text-heal-500' : 'text-gray-400']}>
        <span class:list={['h-2 w-2 rounded-full', d.availableToday ? 'bg-heal-500' : 'bg-gray-300 dark:bg-gray-600']}></span>
        {d.availableToday ? 'Available Today' : 'By Appointment'}
      </span>
    </div>
  </div>
  <div class="mt-4 border-t px-6 py-4 dark:border-night-border">
    <p class="flex items-center gap-1.5 text-xs text-gray-600 dark:text-slate-400">
      <Icon name="clock" size={14} class="text-brand-700 dark:text-brand-400" />
      {d.availability.days.join(', ')} · {d.availability.morning}
    </p>
    {showBooking && (
      <div class="mt-4 flex gap-2">
        <a href={`/doctors/${d.slug}`} class="btn-secondary flex-1 !px-3 !py-2 text-sm">View Profile</a>
        <a href={`/book?doctor=${d.slug}`} class="btn-primary flex-1 !px-3 !py-2 text-sm">
          <Icon name="calendar" size={16} /> Book
        </a>
      </div>
    )}
  </div>
</article>
