---
import { initials } from '../lib/utils'

interface Props {
  name: string
  class?: string
  size?: number
}

const { name, class: className = '', size = 120 } = Astro.props
const inits = initials(name)

const gradientId = 'ag-' + inits.toLowerCase().replace(/\s/g, '')
const gradients: [string, string][] = [
  ['#1E40AF', '#3B82F6'],
  ['#047857', '#10B981'],
  ['#7C3AED', '#A78BFA'],
  ['#B45309', '#F59E0B'],
  ['#9F1239', '#F43F5E'],
  ['#1E3A8A', '#60A5FA'],
]

const hash = inits.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0)
const [a, b] = gradients[hash % gradients.length]
---

<svg
  viewBox="0 0 200 200"
  width={size}
  height={size}
  role="img"
  aria-label={`${name} avatar`}
  class:list={['shrink-0 rounded-full', className]}
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={a} />
      <stop offset="100%" stop-color={b} />
    </linearGradient>
  </defs>
  <circle cx="100" cy="100" r="100" fill={`url(#${gradientId})`} />
  <circle cx="100" cy="82" r="34" fill="rgba(255,255,255,0.92)" />
  <path d="M28 186c6-38 36-58 72-58s66 20 72 58c-12 10-26 14-72 14s-60-4-72-14z" fill="rgba(255,255,255,0.92)" />
  <text x="100" y="110" text-anchor="middle" font-family="Inter, sans-serif" font-size="56" font-weight="700" fill="#1E293B">{inits}</text>
</svg>
