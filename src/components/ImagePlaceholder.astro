  'doctor-w2': { label: 'Doctor', colors: ['#9D174D', '#F472B6'], icon: 'M100 48a20 20 0 100 .01M100 74c-16 0-26 12-28 28 8 6 17 10 28 10s20-4 28-10c-2-16-12-28-28-28zM60 170c2-28 18-40 40-40s38 12 40 40z' },
  'doctor-m2': { label: 'Doctor', colors: ['#B45309', '#FBBF24'], icon: 'M100 48a20 20 0 100 .01M100 74c-16 0-26 12-28 28 8 6 17 10 28 10s20-4 28-10c-2-16-12-28-28-28zM60 170c2-28 18-40 40-40s38 12 40 40z' },
