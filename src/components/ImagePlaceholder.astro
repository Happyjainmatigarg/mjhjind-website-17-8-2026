  'camp2': { label: 'Eye Camp', colors: ['#1E3A8A', '#38BDF8'], icon: 'M50 100c12-30 25-40 50-40s38 10 50 40c-12 30-25 40-50 40s-38-10-50-40zM100 78a22 22 0 100 .01' },
