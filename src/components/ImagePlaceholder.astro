  'maternity': { label: 'Maternity', colors: ['#BE185D', '#F9A8D4'], icon: 'M100 44a16 16 0 100 .01M100 66c-24 0-36 12-38 32 10 8 22 12 38 12s28-4 38-12c-2-20-14-32-38-32z' },
