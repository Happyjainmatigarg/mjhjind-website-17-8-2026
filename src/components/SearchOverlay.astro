---
import Icon from './Icon.astro'
---

<div id="search-overlay" class="fixed inset-0 z-[70] hidden" role="dialog" aria-modal="true" aria-label="Search">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative mx-auto mt-24 w-full max-w-2xl px-4">
    <div class="overflow-hidden rounded-md bg-white shadow-card-xl dark:bg-night-surface">
      <div class="flex items-center gap-3 border-b px-5 dark:border-night-border">
        <Icon name="search" size={22} class="shrink-0 text-gray-400" />
        <input
          type="search"
          id="search-input"
          class="h-16 w-full border-0 bg-transparent text-lg outline-none placeholder:text-gray-400 dark:text-night-text"
          placeholder="Search doctors, services, articles..."
          autocomplete="off"
          aria-label="Search"
        />
        <kbd class="hidden shrink-0 rounded border px-2 py-1 text-xs text-gray-400 dark:border-night-border sm:block">ESC</kbd>
      </div>
      <div id="search-results" class="max-h-[55vh] overflow-y-auto p-4">
        <p class="px-2 py-6 text-center text-sm text-gray-500 dark:text-slate-400">
          Type at least 2 characters to search doctors, services, health camps and blog articles.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('search-overlay')!
  const input = document.getElementById('search-input') as HTMLInputElement
  const results = document.getElementById('search-results')!
  const headerBtns = document.querySelectorAll('#open-search, [data-open-search]')

  const index: { label: string; category: string; href: string; sub: string }[] = []

  index.push({ label: 'Home', category: 'Pages', href: '/', sub: 'Hospital home' })
  index.push({ label: 'About Us', category: 'Pages', href: '/about', sub: 'History, mission, values' })
  index.push({ label: 'Book Appointment', category: 'Pages', href: '/book', sub: 'Online appointment booking' })
  index.push({ label: 'Contact', category: 'Pages', href: '/contact', sub: 'Reach the hospital' })
  index.push({ label: 'Health Camps', category: 'Pages', href: '/camps', sub: 'Free camps & checkups' })
  index.push({ label: 'Health Blog', category: 'Pages', href: '/blog', sub: 'Health articles' })
  index.push({ label: 'Gallery', category: 'Pages', href: '/gallery', sub: 'Photos & events' })
  index.push({ label: 'FAQ', category: 'Pages', href: '/faq', sub: 'Frequently asked questions' })
  index.push({ label: 'Emergency', category: 'Pages', href: '/emergency', sub: '24×7 emergency services' })

  const docEls = document.querySelectorAll<HTMLElement>('[data-search-doctors]')
  const svcEls = document.querySelectorAll<HTMLElement>('[data-search-services]')
  const campEls = document.querySelectorAll<HTMLElement>('[data-search-camps]')
  const postEls = document.querySelectorAll<HTMLElement>('[data-search-posts]')

  docEls.forEach((el) => {
    index.push({
      label: el.dataset.name || '',
      category: 'Doctors',
      href: el.dataset.href || '#',
      sub: el.dataset.specialty || '',
    })
  })
  svcEls.forEach((el) => {
    index.push({
      label: el.dataset.title || '',
      category: 'Services',
      href: el.dataset.href || '#',
      sub: el.dataset.short || '',
    })
  })
  campEls.forEach((el) => {
    index.push({
      label: el.dataset.title || '',
      category: 'Camps',
      href: el.dataset.href || '#',
      sub: el.dataset.type || '',
    })
  })
  postEls.forEach((el) => {
    index.push({
      label: el.dataset.title || '',
      category: 'Articles',
      href: el.dataset.href || '#',
      sub: el.dataset.category || '',
    })
  })

  function open() {
    overlay.classList.remove('hidden')
    overlay.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
    setTimeout(() => input.focus(), 50)
  }

  function close() {
    overlay.classList.add('hidden')
    overlay.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
    input.value = ''
    render(null)
  }

  headerBtns.forEach((b) => b.addEventListener('click', open))

  overlay.querySelector('.absolute')?.addEventListener('click', close)

  const cats: Record<string, string> = {
    Doctors: 'text-brand-800 dark:text-brand-400',
    Services: 'text-heal-600',
    Pages: 'text-warm-500',
    Camps: 'text-danger-600',
    Articles: 'text-brand-800 dark:text-brand-400',
  }

  function render(q: string | null) {
    if (!q || q.trim().length < 2) {
      results.innerHTML = `<p class="px-2 py-6 text-center text-sm text-gray-500 dark:text-slate-400">Type at least 2 characters to search doctors, services, health camps and blog articles.</p>`
      return
    }
    const term = q.toLowerCase()
    const matches = index
      .filter((i) => (i.label + ' ' + i.sub).toLowerCase().includes(term))
      .slice(0, 12)

    if (!matches.length) {
      results.innerHTML = `<div class="px-4 py-8 text-center">
        <p class="text-lg font-semibold" style="color: var(--color-heading)">No results found for "${q}"</p>
        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Try "cardiology", "diabetes", "camp" or "doctor".</p>
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          <a href="/doctors" class="chip border-brand-700 text-brand-800 dark:border-brand-400 dark:text-brand-300">Doctors</a>
          <a href="/services" class="chip border-brand-700 text-brand-800 dark:border-brand-400 dark:text-brand-300">Services</a>
          <a href="/blog" class="chip border-brand-700 text-brand-800 dark:border-brand-400 dark:text-brand-300">Health Blog</a>
        </div>
      </div>`
      return
    }

    const grouped: Record<string, typeof matches> = {}
    matches.forEach((m) => {
      ;(grouped[m.category] ||= []).push(m)
    })

    results.innerHTML =
      `<p class="px-2 pb-3 text-xs font-medium uppercase tracking-wider text-gray-400">${matches.length} result${matches.length > 1 ? 's' : ''} for "${q}"</p>` +
      Object.entries(grouped)
        .map(
          ([cat, items]) => `
        <div class="mb-4">
          <p class="px-2 pb-1.5 text-xs font-semibold uppercase tracking-wider ${cats[cat] || ''}">${cat}</p>
          ${items
            .map(
              (i) => `<a href="${i.href}" class="flex items-center justify-between gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-gray-50 dark:hover:bg-night-bg">
                <span>
                  <span class="block text-sm font-medium" style="color: var(--color-heading)">${i.label}</span>
                  <span class="block text-xs text-gray-500 dark:text-slate-400">${i.sub}</span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-gray-400"><path d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
              </a>`,
            )
            .join('')}
        </div>`,
        )
        .join('')
  }

  input.addEventListener('input', () => render(input.value))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close()
    if (
      e.key === '/' &&
      overlay.classList.contains('hidden') &&
      !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement)
    ) {
      e.preventDefault()
      open()
    }
  })
</script>
