---
interface Props {
  class?: string
  light?: boolean
}
const { class: className = '', light = false } = Astro.props
---

<a href="/" class:list={['inline-flex items-center gap-3', className]} aria-label="Meenakshi Jain Hospital — Home">
  <span class:list={[
    'relative flex h-11 w-11 items-center justify-center rounded-md shadow-card-md transition-transform hover:scale-105',
    light ? 'bg-white' : 'bg-brand-800',
  ]}>
    <svg viewBox="0 0 40 40" class="h-7 w-7" aria-hidden="true">
      <path d="M20 8v24M8 20h24" stroke={light ? '#1E40AF' : '#ffffff'} stroke-width="5" stroke-linecap="round" />
      <path d="M28 8v4M26 10h4" stroke="#10B981" stroke-width="3" stroke-linecap="round" />
    </svg>
  </span>
  <span class="leading-tight">
    <span class:list={['block text-lg font-bold tracking-tight', light ? 'text-white' : 'text-ink dark:text-night-text']}>
      Meenakshi Jain
    </span>
    <span class:list={['block text-xs font-semibold uppercase tracking-[0.18em]', light ? 'text-white/70' : 'text-brand-700 dark:text-brand-400']}>
      Hospital · Jind
    </span>
  </span>
</a>
