---
interface Props {
  class?: string
  light?: boolean
}
const { class: className = '', light = false } = Astro.props
---

<a href="/" class:list={['inline-flex items-center gap-3', className]} aria-label="Meenakshi Jain Hospital — Home">
  <span class="relative flex h-11 w-11 items-center justify-center overflow-hidden rounded-md bg-black shadow-card-md transition-transform hover:scale-105">
    <img src="/logo.png" alt="Meenakshi Jain Hospital logo" class="h-11 w-11 object-contain" />
  </span>
  <span class="leading-tight">
    <span class:list={['block text-lg font-bold tracking-tight', light ? 'text-white' : 'text-ink dark:text-night-text']}>
      Meenakshi Jain
    </span>
    <span class:list={['block text-xs font-semibold uppercase tracking-[0.18em]', light ? 'text-white/70' : 'text-brand-700 dark:text-brand-400']}>
      Hospital · Jind
    </span>
  </span>
</a>
