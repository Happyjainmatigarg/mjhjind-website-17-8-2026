---
import Logo from './Logo.astro'
import Icon from './Icon.astro'
import { hospital } from '../data/site'
import { telHref } from '../lib/utils'
---

<footer class="bg-ink text-slate-300 dark:bg-night-footer" style="background-color: var(--color-footer); color: var(--color-footer-text)">
  <div class="container-site py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <Logo light />
        <p class="mt-4 text-sm leading-relaxed">
          A modern, patient-first hospital serving the people of Jind and surrounding districts since {hospital.foundedYear}. Trusted care, advanced facilities, and a team that treats every patient like family.
        </p>
        <div class="mt-5 flex flex-wrap gap-3" data-site-social>
          {hospital.social.facebook && (
            <a href={hospital.social.facebook} data-social="facebook" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-heal-600">
              <Icon name="facebook" size={18} />
            </a>
          )}
          {hospital.social.instagram && (
            <a href={hospital.social.instagram} data-social="instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-heal-600">
              <Icon name="instagram" size={18} />
            </a>
          )}
          {hospital.social.whatsapp && (
            <a href={hospital.social.whatsapp} data-social="whatsapp" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-heal-600">
              <Icon name="whatsapp" size={18} />
            </a>
          )}
        </div>
      </div>

      <nav aria-label="Quick links">
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider" style="color: var(--color-footer-heading)">Quick Links</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="transition-colors hover:text-white">Home</a></li>
          <li><a href="/about" class="transition-colors hover:text-white">About Us</a></li>
          <li><a href="/doctors" class="transition-colors hover:text-white">Our Doctors</a></li>
          <li><a href="/book" class="transition-colors hover:text-white">Book Appointment</a></li>
          <li><a href="/camps" class="transition-colors hover:text-white">Health Camps</a></li>
          <li><a href="/blog" class="transition-colors hover:text-white">Health Blog</a></li>
          <li><a href="/gallery" class="transition-colors hover:text-white">Gallery</a></li>
        </ul>
      </nav>

      <nav aria-label="Departments">
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider" style="color: var(--color-footer-heading)">Our Services</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/services/cardiology" class="transition-colors hover:text-white">Cardiology</a></li>
          <li><a href="/services/orthopedics" class="transition-colors hover:text-white">Orthopedics</a></li>
          <li><a href="/services/general-medicine" class="transition-colors hover:text-white">General Medicine</a></li>
          <li><a href="/services/pediatrics" class="transition-colors hover:text-white">Pediatrics</a></li>
          <li><a href="/services/gynecology" class="transition-colors hover:text-white">Gynecology</a></li>
          <li><a href="/services/emergency" class="transition-colors hover:text-white">24×7 Emergency</a></li>
        </ul>
      </nav>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider" style="color: var(--color-footer-heading)">Contact Us</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex gap-3">
            <Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-white" />
            <span data-site-address>{hospital.address.line1}, {hospital.address.line2}<br />{hospital.address.city}, {hospital.address.state} — {hospital.address.pincode}</span>
          </li>
          <li class="flex gap-3">
            <Icon name="phone" size={18} class="mt-0.5 shrink-0 text-white" />
            <a href={telHref(hospital.phones.reception)} data-site-phone="reception" class="hover:text-white">{hospital.phones.reception}</a>
          </li>
          <li class="flex gap-3">
            <Icon name="mail" size={18} class="mt-0.5 shrink-0 text-white" />
            <a href={`mailto:${hospital.email}`} data-site-email class="hover:text-white">{hospital.email}</a>
          </li>
          <li class="flex gap-3">
            <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-white" />
            <span data-site-hours="opd">{hospital.hours.opd}</span>
          </li>
        </ul>
        <div class="mt-5 rounded-md border border-white/10 bg-white/5 p-4">
          <p class="flex items-center gap-2 text-sm font-semibold text-white">
            <Icon name="lightning" size={16} class="text-warm-500" /> Emergency: <span data-site-phone="emergency">{hospital.phones.emergency}</span>
          </p>
          <p class="mt-1 text-xs">Ambulance: <span data-site-phone="ambulance">{hospital.phones.ambulance}</span> · 24 × 7 available</p>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site py-6">
      <nav aria-label="Patient information and legal links" class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs sm:justify-start">
        <a href="/patient-rights" class="hover:text-white">Patient Rights</a>
        <a href="/patient-guide" class="hover:text-white">Patient Guide</a>
        <a href="/grievance" class="hover:text-white">Grievance Redressal</a>
        <a href="/refund-cancellation" class="hover:text-white">Refunds &amp; Cancellation</a>
        <a href="/insurance" class="hover:text-white">Insurance &amp; TPA</a>
        <a href="/telemedicine" class="hover:text-white">Telemedicine</a>
        <a href="/hospital-information" class="hover:text-white">Hospital Information</a>
        <a href="/accessibility" class="hover:text-white">Accessibility</a>
        <a href="/privacy" class="hover:text-white">Privacy Policy</a>
        <a href="/terms" class="hover:text-white">Terms of Service</a>
        <a href="/disclaimer" class="hover:text-white">Medical Disclaimer</a>
      </nav>
    </div>
    <div class="border-t border-white/10">
      <div class="container-site flex flex-col items-center justify-between gap-3 py-5 text-xs sm:flex-row">
        <p>© {new Date().getFullYear()} {hospital.name}. All rights reserved.</p>
        <p class="text-center sm:text-right">
          NABH Certified · Emergency 24 × 7 · <a href="/emergency" class="hover:text-white">Emergency &amp; Ambulance</a>
        </p>
      </div>
    </div>
  </div>
</footer>
