---
import SectionHeading from '../SectionHeading.astro'
import TestimonialCard from '../TestimonialCard.astro'
import { testimonials as seedTestimonials } from '../../data/testimonials'
import type { Testimonial } from '../../data/testimonials'

interface Props {
  testimonials?: Testimonial[]
}
const { testimonials = seedTestimonials } = Astro.props
---

<section class="section-pad bg-gray-50 dark:bg-night-surface-alt" style="background-color: var(--color-surface-alt)">
  <div class="container-site">
    <SectionHeading
      eyebrow="Patient Stories"
      title="What Our Patients Say"
      subtitle="Real experiences from families across Jind who have trusted us with their health."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {testimonials.slice(0, 4).map((t) => <TestimonialCard testimonial={t} />)}
    </div>
  </div>
</section>
