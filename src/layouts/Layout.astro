---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import FloatingActions from '../components/FloatingActions.astro'
import SearchOverlay from '../components/SearchOverlay.astro'
import SearchIndex from '../components/SearchIndex.astro'
import Seo from '../components/Seo.astro'
import type { Doctor } from '../data/doctors'
import type { Service } from '../data/services'
import type { HealthCamp } from '../data/camps'
import type { BlogPost } from '../data/blog'
import { hospital } from '../data/site'
import themeScript from '../lib/theme?raw'

interface Props {
  title?: string
  description?: string
  active?: string
  ogImage?: string
  noindex?: boolean
  schema?: object[]
  searchDoctors?: Doctor[]
  searchServices?: Service[]
  searchCamps?: HealthCamp[]
  searchPosts?: BlogPost[]
}

const {
  title,
  description = 'Meenakshi Jain Hospital, Jind — modern, patient-first healthcare with online appointment booking, health camps and a trusted team of doctors. Quality healthcare in Jind.',
  active,
  noindex,
  ogImage = '/og-image.png',
  schema = [],
  searchDoctors,
  searchServices,
  searchCamps,
  searchPosts,
} = Astro.props

const pageTitle = title ? `${title} | ${hospital.name}` : `${hospital.name} — ${hospital.tagline}`
const canonicalPath = Astro.url.pathname
const ogUrl = `https://${hospital.domains.primary}${ogImage}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1E40AF" />
    <meta name="generator" content="Astro" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="author" content={hospital.name} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={hospital.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:site" content="@mjhospitalin" />
    {noindex && <meta name="robots" content="noindex" />}
    <Seo path={canonicalPath} schema={schema} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#1E40AF" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline set:html={themeScript}></script>
  </head>
  <body class="min-h-screen">
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchIndex doctors={searchDoctors} services={searchServices} camps={searchCamps} blogPosts={searchPosts} />
    <SearchOverlay />
    <FloatingActions />
    <div id="toast-container" aria-live="polite" class="pointer-events-none"></div>
    <a href="#" id="back-to-top" class="fixed bottom-6 left-6 z-40 hidden h-12 w-12 items-center justify-center rounded-full border bg-white text-brand-800 shadow-card-lg transition-all hover:-translate-y-1 dark:border-night-border dark:bg-night-surface dark:text-slate-200" aria-label="Back to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 15.75l7.5-7.5 7.5 7.5"/></svg>
    </a>
    <script>
      const backToTop = document.getElementById('back-to-top')
      window.addEventListener('scroll', () => {
        if (!backToTop) return
        const show = window.scrollY > 600
        backToTop.classList.toggle('hidden', !show)
        backToTop.classList.toggle('flex', show)
      })

      const revealEls = document.querySelectorAll('[data-reveal]')
      if (revealEls.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed')
                io.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        )
        revealEls.forEach((el) => io.observe(el))
      } else {
        revealEls.forEach((el) => el.classList.add('revealed'))
      }
    </script>
  </body>
</html>
