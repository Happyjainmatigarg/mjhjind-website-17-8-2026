---
import '../styles/global.css'
import Icon from '../components/Icon.astro'
import { adminCollections, adminPages } from '../lib/admin/config'
import { hospital } from '../data/site'

interface Props {
  active?: string
}

const { active = 'dashboard' } = Astro.props

const groups: { label: string; names: string[] }[] = [
  { label: 'Requests', names: ['appointments', 'campRegistrations', 'contacts', 'newsletter'] },
  { label: 'Content', names: ['doctors', 'blogPosts', 'camps', 'services', 'faqs', 'gallery', 'testimonials'] },
]

const pageGroups: { label: string; pages: typeof adminPages }[] = ['Insights', 'Settings', 'System'].map((label) => ({
  label,
  pages: adminPages.filter((p) => p.group === label),
}))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — {hospital.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('mjh-theme')
        const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        document.documentElement.classList.toggle('dark', theme === 'dark')
      } catch {
        /* ignore */
      }
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-surface-alt text-gray-900 antialiased dark:bg-night-bg dark:text-slate-200">
    <div class="flex min-h-screen">
      <header class="fixed inset-x-0 top-0 z-50 flex h-14 items-center justify-between bg-brand-900 px-4 text-white lg:hidden">
        <a href="/admin" class="flex min-w-0 items-center gap-2">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-md bg-black">
            <img src="/logo.png" alt="" class="h-9 w-9 object-contain" />
          </span>
          <span class="truncate text-sm font-bold">Admin</span>
        </a>
        <button type="button" id="admin-menu-toggle" class="inline-flex h-11 w-11 items-center justify-center rounded-full" aria-label="Open admin menu" aria-expanded="false" aria-controls="admin-sidebar">
          <Icon name="menu" size={24} />
        </button>
      </header>
      <div id="admin-overlay" class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"></div>
      <aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 flex w-64 max-w-[85vw] -translate-x-full flex-col bg-brand-900 text-white transition-transform duration-200 lg:!translate-x-0 dark:bg-night-surface">
        <a href="/admin" class="flex items-center gap-3 border-b border-white/10 px-5 py-5">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-md bg-black">
            <img src="/logo.png" alt="" class="h-10 w-10 object-contain" />
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-bold leading-tight">{hospital.name}</span>
            <span class="block text-xs text-white/60">Admin Panel</span>
          </span>
        </a>
        <nav class="flex-1 overflow-y-auto px-3 py-4">
          <a
            href="/admin"
            class:list={['mb-2 flex items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium transition-colors', active === 'dashboard' ? 'bg-white/15 text-white' : 'text-white/70 hover:bg-white/10 hover:text-white']}
          >
            <Icon name="database" size={18} /> Dashboard
          </a>
          {groups.map((g) => (
            <div class="mb-4">
              <p class="px-3 pb-1.5 pt-3 text-[11px] font-semibold uppercase tracking-wider text-white/40">{g.label}</p>
              {g.names.map((name) => {
                const cfg = adminCollections.find((c) => c.name === name)
                if (!cfg) return null
                return (
                  <a
                    href={`/admin/${name}`}
                    class:list={['flex items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium transition-colors', active === name ? 'bg-white/15 text-white' : 'text-white/70 hover:bg-white/10 hover:text-white']}
                  >
                    <Icon name={cfg.icon} size={18} /> {cfg.label}
                  </a>
                )
              })}
            </div>
          ))}
          {pageGroups.map((g) => (
            <div class="mb-4">
              <p class="px-3 pb-1.5 pt-3 text-[11px] font-semibold uppercase tracking-wider text-white/40">{g.label}</p>
              {g.pages.map((p) => (
                <a
                  href={`/admin/${p.name}`}
                  class:list={['flex items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium transition-colors', active === p.name ? 'bg-white/15 text-white' : 'text-white/70 hover:bg-white/10 hover:text-white']}
                >
                  <Icon name={p.icon} size={18} /> {p.label}
                </a>
              ))}
            </div>
          ))}
        </nav>
        <div class="border-t border-white/10 p-3">
          <a href="/" class="flex items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white" target="_blank">
            <Icon name="external-link" size={18} /> View Website
          </a>
          <button id="admin-logout" class="flex w-full items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium text-white/70 transition-colors hover:bg-danger-600/20 hover:text-white">
            <Icon name="logout" size={18} /> Sign Out
          </button>
        </div>
      </aside>

      <main class="min-w-0 flex-1 px-4 pb-8 pt-20 lg:ml-64 lg:p-10">
        <slot />
      </main>
    </div>

    <script>
      document.getElementById('admin-logout')?.addEventListener('click', () => {
        localStorage.removeItem('mj-admin-token')
        localStorage.removeItem('mj-admin-user')
        window.location.href = '/admin'
      })
      const sidebar = document.getElementById('admin-sidebar')
      const overlay = document.getElementById('admin-overlay')
      const toggle = document.getElementById('admin-menu-toggle')
      function openAdminNav() {
        sidebar?.classList.remove('-translate-x-full')
        overlay?.classList.remove('hidden')
        toggle?.setAttribute('aria-expanded', 'true')
        document.body.style.overflow = 'hidden'
      }
      function closeAdminNav() {
        sidebar?.classList.add('-translate-x-full')
        overlay?.classList.add('hidden')
        toggle?.setAttribute('aria-expanded', 'false')
        document.body.style.overflow = ''
      }
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true'
        if (open) closeAdminNav()
        else openAdminNav()
      })
      overlay?.addEventListener('click', closeAdminNav)
      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.matchMedia('(max-width: 1023px)').matches) closeAdminNav()
        })
      })
    </script>
  </body>
</html>
