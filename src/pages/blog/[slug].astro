---
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import ImagePlaceholder from '../../components/ImagePlaceholder.astro'
import BlogCard from '../../components/BlogCard.astro'
import Icon from '../../components/Icon.astro'
import NewsletterForm from '../../components/NewsletterForm.astro'
import { getCollection, getItemById } from '../../lib/server/store'
import type { BlogPost } from '../../data/blog'
import { formatDate } from '../../lib/utils'
import { hospital } from '../../data/site'

export const prerender = false

const { slug } = Astro.params
const blogPosts = getCollection<BlogPost>('blogPosts')
const post = getItemById<BlogPost>('blogPosts', slug || '')
if (!post) return Astro.redirect('/404')

function renderMarkdown(blocks: string[]): string {
  return blocks
    .map((block) => {
      const b = block.trim()
      if (b.startsWith('### ')) return `<h3>${b.slice(4)}</h3>`
      if (b.startsWith('## ')) return `<h2>${b.slice(3)}</h2>`
      if (b.startsWith('> ')) return `<blockquote>${b.slice(2)}</blockquote>`
      if (b.startsWith('- ')) {
        const items = b.split('\n').map((l) => l.replace(/^-\s*/, '')).filter(Boolean)
        return `<ul>${items.map((i) => `<li>${i}</li>`).join('')}</ul>`
      }
      if (/^\d+\./.test(b)) {
        const items = b.split('\n').map((l) => l.replace(/^\d+\.\s*/, '')).filter(Boolean)
        return `<ol>${items.map((i) => `<li>${i}</li>`).join('')}</ol>`
      }
      const escaped = b
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
      return `<p>${escaped}</p>`
    })
    .join('')
}

const htmlContent = renderMarkdown(post.content)
const related = blogPosts.filter((p) => p.slug !== post.slug && (p.category === post.category || p.tags.some((t) => post.tags.includes(t)))).slice(0, 3)
const fallbackRelated = related.length >= 2 ? related : [...related, ...blogPosts.filter((p) => p.slug !== post.slug && !related.includes(p))].slice(0, 3)
const categories = blogPosts.reduce((acc, p) => (acc.includes(p.category) ? acc : acc.concat(p.category)), [] as string[])
const shareUrl = `https://${hospital.domains.primary}/blog/${post.slug}`
const shareText = encodeURIComponent(post.title)
const next = blogPosts[blogPosts.findIndex((p) => p.slug === post.slug) + 1]
const prev = blogPosts[blogPosts.findIndex((p) => p.slug === post.slug) - 1]
const postUrl = `https://${hospital.domains.primary}/blog/${post.slug}`

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  author: {
    '@type': 'Person',
    name: post.author,
    jobTitle: post.authorTitle,
  },
  publisher: {
    '@type': 'Hospital',
    name: hospital.name,
    url: `https://${hospital.domains.primary}`,
  },
  image: `https://${hospital.domains.primary}/og-image.png`,
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  keywords: post.tags.join(', '),
  articleSection: post.category,
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${hospital.domains.primary}/` },
    { '@type': 'ListItem', position: 2, name: 'Health Blog', item: `https://${hospital.domains.primary}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
  ],
}
---

<Layout title={post.title} active="blog" description={post.excerpt} schema={[articleSchema, breadcrumbSchema]}>
  <PageHero eyebrow={`${post.category} · ${post.readTime} min read`} title={post.title} subtitle={`By ${post.author} · ${formatDate(post.date)}`} breadcrumb="/blog" showEmergency={false} />

  <article class="section-pad">
    <div class="container-site grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <ImagePlaceholder image={post.image} title={post.category} class="rounded-md shadow-card-md" />
        <div class="prose-content mt-8" set:html={htmlContent}></div>

        <div class="mt-8 flex flex-wrap items-center gap-2 border-t pt-6 dark:border-night-border">
          <span class="mr-1 text-sm font-medium text-gray-500 dark:text-slate-400">Share:</span>
          <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-[#25D366] text-white transition-transform hover:scale-110" aria-label="Share on WhatsApp">
            <Icon name="whatsapp" size={18} />
          </a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1877F2] text-white transition-transform hover:scale-110" aria-label="Share on Facebook">
            <Icon name="facebook" size={18} />
          </a>
          <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-white transition-transform hover:scale-110 dark:bg-white dark:text-gray-900" aria-label="Share on X">
            <Icon name="x-social" size={18} />
          </a>
          <button type="button" id="copy-link" class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-700 transition-transform hover:scale-110 dark:bg-night-border dark:text-slate-200" aria-label="Copy link">
            <Icon name="link" size={18} />
          </button>
        </div>

        <div class="mt-8 flex items-start gap-4 rounded-md border bg-gray-50 p-6 dark:border-night-border dark:bg-night-surface">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-800 text-lg font-bold text-white">
            {post.author.replace('Dr. ', '').split(' ').map((p) => p[0]).join('').slice(0, 2)}
          </span>
          <div>
            <p class="font-semibold">{post.author}</p>
            <p class="text-sm text-gray-500 dark:text-slate-400">{post.authorTitle} at {hospital.name}</p>
            <p class="mt-1 text-sm text-gray-600 dark:text-slate-300">Articles reflect the personal experience and knowledge of our doctors and are for general information. Always consult a doctor for medical advice specific to you.</p>
          </div>
        </div>
      </div>

      <aside class="space-y-6">
        <div>
          <NewsletterForm variant="card" />
        </div>

        <div class="card">
          <h3 class="font-semibold">Categories</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {categories.map((c) => (
              <a href={`/blog?cat=${c}`} class="chip border-gray-300 text-gray-600 hover:border-brand-700 hover:text-brand-800 dark:border-night-border dark:text-slate-300 dark:hover:border-brand-400">{c}</a>
            ))}
          </div>
        </div>

        <div class="card">
          <h3 class="font-semibold">Tags</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {post.tags.map((t) => (
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-night-border dark:text-slate-300">#{t}</span>
            ))}
          </div>
        </div>

        {next && (
          <a href={`/blog/${next.slug}`} class="card card-hover group block">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-400">Next Article</p>
            <p class="mt-2 font-semibold leading-snug group-hover:text-brand-700 dark:group-hover:text-brand-400">{next.title}</p>
          </a>
        )}
      </aside>
    </div>
  </article>

  <section class="bg-gray-50 dark:bg-night-surface-alt" style="background-color: var(--color-surface-alt)">
    <div class="container-site section-pad">
      <h2 class="text-2xl font-bold">Related Articles</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {fallbackRelated.map((p) => <BlogCard post={p} />)}
      </div>
      <div class="mt-10 flex justify-between">
        {prev ? <a href={`/blog/${prev.slug}`} class="btn-secondary !py-2 text-sm"><Icon name="arrow-left" size={16} /> Previous</a> : <span></span>}
        {next ? <a href={`/blog/${next.slug}`} class="btn-secondary !py-2 text-sm">Next <Icon name="arrow-right" size={16} /></a> : <span></span>}
      </div>
    </div>
  </section>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-link')
  copyBtn?.addEventListener('click', async () => {
    const url = window.location.href
    try {
      await navigator.clipboard.writeText(url)
      copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.75l6 6 9-13.5"/></svg>'
      setTimeout(() => {
        copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/></svg>'
      }, 1500)
    } catch {
      /* clipboard unavailable */
    }
  })
</script>
