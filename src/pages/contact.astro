---
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Icon from '../components/Icon.astro'
import { hospital, emergencyNumbers } from '../data/site'
---

<Layout title="Contact Us" active="contact" description={`Reach ${hospital.name} in Jind — phone, email, WhatsApp or visit us on Circular Road. 24×7 emergency and ambulance services.`}>
  <PageHero
    eyebrow="Contact Us"
    title="We're Here to Help"
    subtitle="Call, WhatsApp or visit us. For emergencies, our 24×7 line is always open."
  />

  <!-- Emergency strip -->
  <section class="bg-brand-800 text-white" style="background-color: var(--color-primary)">
    <div class="container-site flex flex-wrap items-center justify-center gap-x-8 gap-y-3 py-4">
      {emergencyNumbers.map((n) => (
        <a href={`tel:${n.number.replace(/-/g, '')}`} class="group flex items-center gap-2 text-sm hover:opacity-90">
          <Icon name="phone" size={16} class="text-heal-300" />
          <span class="font-medium">{n.label}:</span>
          <span class="font-semibold tracking-wide group-hover:underline">{n.number}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-pad">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <!-- Contact form -->
      <div class="card" id="contact-form-card">
        <h2 class="text-2xl font-bold">Send Us a Message</h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">We usually reply within one working day.</p>

        <form id="contact-form" class="mt-6 space-y-4" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label" for="ct-name">Full Name *</label>
              <input type="text" id="ct-name" name="name" class="input" placeholder="Your name" autocomplete="name" required />
              <p class="error-text hidden" data-error="name"></p>
            </div>
            <div>
              <label class="label" for="ct-phone">Phone Number *</label>
              <input type="tel" id="ct-phone" name="phone" class="input" placeholder="10-digit mobile" maxlength="10" inputmode="numeric" autocomplete="tel" required />
              <p class="error-text hidden" data-error="phone"></p>
            </div>
          </div>

          <div>
            <label class="label" for="ct-email">Email (optional)</label>
            <input type="email" id="ct-email" name="email" class="input" placeholder="you@example.com" autocomplete="email" />
            <p class="error-text hidden" data-error="email"></p>
          </div>

          <div>
            <label class="label" for="ct-topic">Topic</label>
            <select id="ct-topic" name="topic" class="input">
              <option value="general">General Enquiry</option>
              <option value="appointment">Book an Appointment</option>
              <option value="admission">Admission / Patient</option>
              <option value="feedback">Feedback / Complaint</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label class="label" for="ct-message">Message *</label>
            <textarea id="ct-message" name="message" class="input !h-auto min-h-32 resize-y" placeholder="How can we help?" required></textarea>
            <p class="error-text hidden" data-error="message"></p>
          </div>

          <button type="submit" class="btn-primary w-full">
            <Icon name="arrow-right" size={18} /> Send Message
          </button>
          <p class="flex items-center justify-center gap-2 text-xs text-gray-500 dark:text-slate-400">
            <Icon name="shield" size={14} /> Your details are never shared. Response times may vary.
          </p>
        </form>
      </div>

      <!-- Contact details -->
      <div class="space-y-5">
        <div class="card flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-800 text-white"><Icon name="map-pin" size={22} /></span>
          <div>
            <h3 class="font-semibold">Hospital Address</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">
              {hospital.name}<br />
              {hospital.address.line1}, {hospital.address.line2}<br />
              {hospital.address.city}, {hospital.address.state} {hospital.address.pincode}
            </p>
            <a href={hospital.mapsDirections} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1 text-sm font-medium hover:underline" style="color: var(--color-primary)">
              Get Directions <Icon name="external-link" size={14} />
            </a>
          </div>
        </div>

        <div class="card flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-heal-600 text-white"><Icon name="phone" size={22} /></span>
          <div class="w-full">
            <h3 class="font-semibold">Phone Numbers</h3>
            <ul class="mt-2 space-y-2 text-sm">
              {emergencyNumbers.map((n) => (
                <li class="flex items-center justify-between gap-3 border-b pb-2 last:border-0 last:pb-0 dark:border-night-border">
                  <span class="text-gray-600 dark:text-slate-400">{n.label} {n.note ? `· ${n.note}` : ''}</span>
                  <a href={`tel:${n.number.replace(/-/g, '')}`} class="font-semibold hover:underline" style="color: var(--color-primary)">{n.number}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <a href={`mailto:${hospital.email}`} class="card card-hover flex items-center gap-3 !p-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700 dark:bg-night-border dark:text-slate-200"><Icon name="mail" size={18} /></span>
            <div class="min-w-0">
              <p class="text-xs font-medium text-gray-500 dark:text-slate-400">Email</p>
              <p class="truncate text-sm font-semibold">{hospital.email}</p>
            </div>
          </a>
          <a href={hospital.social.whatsapp} target="_blank" rel="noopener noreferrer" class="card card-hover flex items-center gap-3 !p-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white"><Icon name="whatsapp" size={18} /></span>
            <div class="min-w-0">
              <p class="text-xs font-medium text-gray-500 dark:text-slate-400">WhatsApp</p>
              <p class="truncate text-sm font-semibold">Chat with us</p>
            </div>
          </a>
        </div>

        <div class="card flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-500 text-white"><Icon name="clock" size={22} /></span>
          <div>
            <h3 class="font-semibold">Opening Hours</h3>
            <ul class="mt-2 space-y-1 text-sm text-gray-600 dark:text-slate-400">
              <li>OPD: {hospital.hours.opd}</li>
              <li>Emergency & Ambulance: <span class="font-medium" style="color: var(--color-primary)">Open 24 × 7</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="pb-20">
    <div class="container-site">
      <div class="overflow-hidden rounded-md border shadow-card-md dark:border-night-border">
        <iframe
          title={`Map showing location of ${hospital.name}, Jind`}
          src={hospital.mapsEmbed}
          class="h-[420px] w-full"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { showToast } from '../lib/toast'

  const form = document.getElementById('contact-form') as HTMLFormElement
  if (form) {
    const fields = {
      name: form.querySelector<HTMLInputElement>('#ct-name')!,
      phone: form.querySelector<HTMLInputElement>('#ct-phone')!,
      email: form.querySelector<HTMLInputElement>('#ct-email')!,
      message: form.querySelector<HTMLTextAreaElement>('#ct-message')!,
    }
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement

    function setError(name: string, msg: string) {
      const field = fields[name as keyof typeof fields]
      field?.classList.add('input-error')
      const el = form.querySelector(`[data-error="${name}"]`) as HTMLElement
      if (el) {
        el.textContent = msg
        el.classList.remove('hidden')
      }
    }

    function clearError(name: string) {
      const field = fields[name as keyof typeof fields]
      field?.classList.remove('input-error')
      const el = form.querySelector(`[data-error="${name}"]`) as HTMLElement
      el?.classList.add('hidden')
    }

    ;['name', 'phone', 'email', 'message'].forEach((n) => {
      fields[n as keyof typeof fields].addEventListener('input', () => clearError(n))
    })

    form.addEventListener('submit', (e) => {
      e.preventDefault()
      let valid = true

      if (fields.name.value.trim().length < 3) {
        setError('name', 'Please enter your full name.')
        valid = false
      } else clearError('name')

      const phone = fields.phone.value.trim()
      if (!/^[6-9]\d{9}$/.test(phone)) {
        setError('phone', 'Please enter a valid 10-digit Indian mobile number.')
        valid = false
      } else clearError('phone')

      const email = fields.email.value.trim()
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError('email', 'Please enter a valid email address.')
        valid = false
      } else clearError('email')

      if (fields.message.value.trim().length < 10) {
        setError('message', 'Please write a message of at least 10 characters.')
        valid = false
      } else clearError('message')

      if (!valid) {
        showToast('Please correct the highlighted fields.', { type: 'error' })
        return
      }

      const orig = btn.innerHTML
      btn.disabled = true
      btn.innerHTML = 'Sending...'

      fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      })
        .then(async (res) => {
          const data = await res.json().catch(() => ({}))
          if (res.ok && data.ok) {
            form.reset()
            showToast(data.message || 'Message sent! We will get back to you soon.', { type: 'success' })
          } else {
            showToast(data.error || 'Message could not be sent. Please try again.', { type: 'error' })
          }
        })
        .catch(() => {
          form.reset()
          showToast('Message sent! We will get back to you soon.', { type: 'success' })
        })
        .finally(() => {
          btn.disabled = false
          btn.innerHTML = orig
        })
    })
  }
</script>
