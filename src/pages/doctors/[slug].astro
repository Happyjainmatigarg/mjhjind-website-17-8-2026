---
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import DoctorAvatar from '../../components/DoctorAvatar.astro'
import DoctorCard from '../../components/DoctorCard.astro'
import Icon from '../../components/Icon.astro'
import { getCollection, getItemById } from '../../lib/server/store'
import type { Doctor } from '../../data/doctors'
import { hospital } from '../../data/site'

export const prerender = false

const { slug } = Astro.params
const doctors = getCollection<Doctor>('doctors')
const d = getItemById<Doctor>('doctors', slug || '')
if (!d) return Astro.redirect('/404')
const others = doctors.filter((x) => x.slug !== d.slug).slice(0, 4)

const doctorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: d.name,
  image: `https://${hospital.domains.primary}/favicon-512.png`,
  medicalSpecialty: d.specialty,
  knowsAbout: [d.specialty, d.qualification],
  description: d.bio,
  url: `https://${hospital.domains.primary}/doctors/${d.slug}`,
  memberOf: {
    '@type': 'Hospital',
    name: hospital.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: `${hospital.address.line1}, ${hospital.address.line2}`,
      addressLocality: hospital.address.city,
      addressRegion: hospital.address.state,
      postalCode: hospital.address.pincode,
      addressCountry: 'IN',
    },
  },
  workLocation: {
    '@type': 'Hospital',
    name: hospital.name,
    telephone: hospital.phones.appointment,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${hospital.address.line1}, ${hospital.address.line2}`,
    addressLocality: hospital.address.city,
    addressRegion: hospital.address.state,
    postalCode: hospital.address.pincode,
    addressCountry: 'IN',
  },
  availableService: { '@type': 'MedicalProcedure', name: d.specialty },
}
---

<Layout title={d.name} active="doctors" description={`${d.name} — ${d.specialty} at ${hospital.name}, Jind. Qualifications: ${d.qualification}. Book an appointment online.`} schema={[doctorSchema]}>
  <PageHero eyebrow="Doctor Profile" title={d.name} subtitle={`${d.specialty} · ${d.qualification}`} breadcrumb="/doctors" />

  <section class="section-pad">
    <div class="container-site grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="card !p-8">
          <div class="flex flex-col gap-6 sm:flex-row">
            <DoctorAvatar name={d.name} size={160} class="ring-4 ring-brand-100 dark:ring-night-border" />
            <div class="flex-1">
              <h2 class="text-2xl font-bold">{d.name}</h2>
              <p class="text-base font-medium text-brand-700 dark:text-brand-400">{d.title}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="badge badge-blue">{d.specialty}</span>
                <span class="badge badge-green">{d.experience} years experience</span>
                <span class:list={['badge', d.availableToday ? 'badge-green' : 'badge-gray']}>
                  {d.availableToday ? 'Available Today' : 'By Appointment'}
                </span>
              </div>
              <dl class="mt-5 space-y-2 text-sm">
                <div class="flex gap-2">
                  <dt class="w-36 shrink-0 font-medium text-gray-500 dark:text-slate-400">Qualification</dt>
                  <dd>{d.qualification}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="w-36 shrink-0 font-medium text-gray-500 dark:text-slate-400">Registration</dt>
                  <dd class="font-medium">{d.registrationNumber} · {d.registrationCouncil}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="w-36 shrink-0 font-medium text-gray-500 dark:text-slate-400">Languages</dt>
                  <dd>{d.languages.join(', ')}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="w-36 shrink-0 font-medium text-gray-500 dark:text-slate-400">OPD Fee</dt>
                  <dd>₹{d.opdFees}</dd>
                </div>
              </dl>
            </div>
          </div>

          <h3 class="mt-8 text-lg font-semibold">About {d.name}</h3>
          <p class="mt-3 leading-relaxed text-gray-700 dark:text-slate-300">{d.bio}</p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            <div>
              <h3 class="text-lg font-semibold">Highlights</h3>
              <ul class="mt-3 space-y-2">
                {d.highlights.map((h) => (
                  <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-slate-300">
                    <Icon name="check" size={16} class="mt-0.5 shrink-0 text-heal-600" /> {h}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-lg font-semibold">Education</h3>
              <ul class="mt-3 space-y-2">
                {d.education.map((e) => (
                  <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-slate-300">
                    <Icon name="academic" size={16} class="mt-0.5 shrink-0 text-brand-700 dark:text-brand-400" /> {e}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <h3 class="mt-8 text-lg font-semibold">Consultation Hours</h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <div class="rounded-md border p-4 dark:border-night-border">
              <p class="flex items-center gap-2 text-sm font-semibold text-heal-600 dark:text-heal-500">
                <Icon name="sun" size={16} /> Morning
              </p>
              <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">{d.availability.morning}</p>
            </div>
            <div class="rounded-md border p-4 dark:border-night-border">
              <p class="flex items-center gap-2 text-sm font-semibold text-warm-500">
                <Icon name="moon" size={16} /> Evening
              </p>
              <p class="mt-1 text-sm text-gray-700 dark:text-slate-300">{d.availability.evening}</p>
            </div>
          </div>
          <p class="mt-3 text-sm text-gray-600 dark:text-slate-400">
            Available on: <span class="font-medium">{d.availability.days.join(', ')}</span>
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href={`/book?doctor=${d.slug}`} class="btn-primary">
              <Icon name="calendar" size={18} /> Book Appointment
            </a>
            <a href={`tel:${hospital.phones.appointment.replace(/\D/g, '')}`} class="btn-secondary">
              <Icon name="phone" size={18} /> Call to Book
            </a>
          </div>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="card">
          <h3 class="font-semibold">Quick Contact</h3>
          <ul class="mt-4 space-y-3 text-sm">
            <li class="flex items-center gap-3">
              <Icon name="phone" size={18} class="text-brand-700 dark:text-brand-400" />
              <a href={`tel:${hospital.phones.appointment.replace(/\D/g, '')}`} class="hover:underline">{hospital.phones.appointment}</a>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="clock" size={18} class="text-brand-700 dark:text-brand-400" />
              <span>{hospital.hours.opd}</span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="map-pin" size={18} class="text-brand-700 dark:text-brand-400" />
              <span>{hospital.address.line1}, {hospital.address.city}</span>
            </li>
          </ul>
          <a href="/book" class="btn-primary mt-5 w-full"><Icon name="calendar" size={18} /> Book Online</a>
        </div>

        <div class="card bg-heal-50 dark:bg-heal-500/10">
          <h3 class="font-semibold text-heal-700 dark:text-heal-500">Emergency?</h3>
          <p class="mt-2 text-sm text-gray-700 dark:text-slate-300">24×7 emergency and ambulance services.</p>
          <a href={`tel:${hospital.phones.emergency.replace(/\D/g, '')}`} class="btn mt-4 w-full bg-danger-600 py-2.5 text-sm text-white hover:bg-danger-700">
            <Icon name="phone-solid" size={16} /> {hospital.phones.emergency}
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-night-surface-alt" style="background-color: var(--color-surface-alt)">
    <div class="container-site section-pad">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">More Doctors</p>
          <h2 class="mt-2 text-2xl font-bold md:text-3xl">Other Specialists You Can Consult</h2>
        </div>
        <a href="/doctors" class="btn-secondary hidden !px-4 !py-2 text-sm sm:inline-flex">View All</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((o) => <DoctorCard doctor={o} />)}
      </div>
    </div>
  </section>
</Layout>
